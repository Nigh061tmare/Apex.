    }
  },
  "command": {
    "audit": {
      "description": "🌙 Auditoría de Roster Flexible: usa OpenRouter o Gemini (Uso: audit [gemini|nemotron|minimax|ling] [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"$1\" \"$2\" \"$3\""
    },
    "audit_openrouter": {
      "description": "⚡ Auditoría con OpenRouter gratuito: Nemotron / MiniMax / Ling (Uso: audit_openrouter [nemotron|minimax|ling] [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"$1\" \"$2\" \"$3\""
    },
    "audit_gemini": {
      "description": "🌐 Auditoría con la API oficial de Google Gemini Flash Lite (Uso: audit_gemini [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"gemini\" \"$1\" \"$2\""
    },
    "audit_muse": {
      "description": "🔥 Auditoría Nocturna con Meta Muse Spark 1.3 Free (OpenCode Zen / 1M Contexto) (Uso: audit_muse [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"muse\" \"$1\" \"$2\""
    },
    "validate": {
      "description": "🛡️ Validador Canónico APEX: audita y auto-corrige en 100ms formas base, multiplicadores, Ki y franquicias en todo el roster activo",
      "template": "node src/scripts/rosterCanonicalValidator.js"
    },
    "enrich": {
      "description": "⚡ Enriquecedor Táctico: añade arsenales con stamina, combos de 3 fases, sinergias y pasivas (Uso: enrich [full_enrichment|synergies_combos] [universo|all])",
      "template": "node src/scripts/runAutonomousTask.js \"$1\" \"$2\""
    },
    "apply": {
      "description": "📦 Aplica todos los parches generados en characters.js con auto-corrección canónica y backup de seguridad",
      "template": "node src/scripts/applyEnrichmentPatches.js"
    },
    "deploy": {
      "description": "🚀 Despliega el proyecto directamente a producción en Vercel con verificación HTTP 200",
      "template": "node -e \"import('child_process').then(cp => cp.execSync('npx vercel --prod --yes', {stdio: 'inherit'}))\""
    },
    "status": {
      "description": "📊 Muestra el progreso de la auditoría y estado del roster en tiempo real",
      "template": "node src/scripts/checkAuditProgress.js"
    },
    "test": {
      "description": "🧪 Ejecuta las pruebas completas de integridad del motor APEX",
      "template": "node src/scripts/runComprehensiveTests.js"
    },
    "verify": {
      "description": "🔍 Verifica multiplicadores y escalado en vivo del Scouter",
      "template": "node src/scripts/verifyLiveScaling.js"
    },
    "build": {
      "description": "🔨 Compila el bundle de producción de Vite",
      "template": "npm run build"
    },
    "devtools": {
      "description": "🌐 Abre Chrome con DevTools MCP y prueba la UI en vivo (http://localhost:5173)",
      "template": "npx -y chrome-devtools-mcp@latest --browserUrl http://127.0.0.1:9222"
    },
    "screen": {
      "description": "🖥️ Captura en vivo la pantalla completa del usuario para análisis visual y depuración de UI",
      "template": "powershell -ExecutionPolicy Bypass -File \"tools\\opencode\\capture_screen.ps1\" -Json"
    },
    "record": {
      "description": "🎥 Graba una ráfaga de 3 segundos (10 frames) para analizar animaciones y errores transitorios",
      "template": "powershell -ExecutionPolicy Bypass -File \"tools\\opencode\\record_screen.ps1\" -Frames 10 -IntervalMs 300 -Json"
    },
    "memory": {
      "description": "🧠 Administra la memoria persistente a largo plazo del agente",
      "template": "npx -y @modelcontextprotocol/server-memory"
    },
    "browser": {
      "description": "🧭 Navega y busca en la web estilo Vane/Perplexity con citas y fuentes en tiempo real (100% Gratis)",
      "template": "node tools/vane/vane_cli.cjs \"$1\""
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated"
      ],
      "enabled": true
    },
    "chrome-devtools-remote": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "enabled": true
    },
    "vane_browser": {
      "type": "local",
      "command": [
        "node",
        "Z:/apex-powerscaling-engine/tools/vane/vane_mcp_server.cjs"
      ],
      "enabled": true
    }
  }
}
