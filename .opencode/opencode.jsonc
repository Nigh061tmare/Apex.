{
  "$schema": "https://opencode.ai/config.json",
  // ════════════════════════════════════════════════════════════════════════
  //  MODELO PREDETERMINADO: OpenRouter GRATIS (no consume cuota OpenCode Go)
  //  Cuando se renueve la cuota semanal, cambiar a:
  //    "model": "opencode-go/deepseek-v4-flash"
  //    "default_agent": "deepseek_fast"
  // ════════════════════════════════════════════════════════════════════════
  "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
  "small_model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
  "instructions": [
    "APEX_RULES.md",
    ".opencode/ANTIGRAVITY_SUPERIOR_CORE.md",
    "GLOBAL_CORE.md"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow"
  },
  "command": {
    "audit": {
      "description": "🌙 Auditoría de Roster Flexible: usa OpenRouter o Gemini (Uso: audit [gemini|nemotron|minimax|ling] [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"$1\" \"$2\" \"$3\""
    },
    "audit_openrouter": {
      "description": "⚡ Auditoría con OpenRouter gratuito: Nemotron / MiniMax / Ling (Uso: audit_openrouter [nemotron|minimax|ling] [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"$1\" \"$2\" \"$3\""
    },
    "audit_gemini": {
      "description": "🌐 Auditoría con la API oficial de Google Gemini Flash Lite (Uso: audit_gemini [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"gemini\" \"$1\" \"$2\""
    },
    "audit_muse": {
      "description": "🔥 Auditoría Nocturna con Meta Muse Spark 1.3 Free (OpenRouter / 1M Contexto) (Uso: audit_muse [universo] [ficha_inicio])",
      "template": "node src/scripts/runAuditDispatcher.js \"muse\" \"$1\" \"$2\""
    },
    "validate": {
      "description": "🛡️ Validador Canónico APEX: audita y auto-corrige formas base, multiplicadores, Ki y franquicias en todo el roster activo",
      "template": "node src/scripts/rosterCanonicalValidator.js"
    },
    "build": {
      "description": "🔨 Compila el bundle de producción de Vite",
      "template": "npm run build"
    },
    "devtools": {
      "description": "🌐 Abre Chrome con DevTools MCP y prueba la UI en vivo (http://localhost:5173)",
      "template": "npx -y chrome-devtools-mcp@latest --browserUrl http://127.0.0.1:9222"
    },
    "screen": {
      "description": "🖥️ Captura en vivo la pantalla completa del usuario para análisis visual y depuración de UI",
      "template": "powershell -ExecutionPolicy Bypass -File \"tools\\opencode\\capture_screen.ps1\" -Json"
    },
    "record": {
      "description": "🎥 Graba una ráfaga de 3 segundos (10 frames) para analizar animaciones y errores transitorios",
      "template": "powershell -ExecutionPolicy Bypass -File \"tools\\opencode\\record_screen.ps1\" -Frames 10 -IntervalMs 300 -Json"
    },
    "memory": {
      "description": "🧠 Administra la memoria persistente a largo plazo del agente",
      "template": "npx -y @modelcontextprotocol/server-memory"
    },
    "browser": {
      "description": "🧭 Navega y busca en la web estilo Vane/Perplexity con citas y fuentes en tiempo real (100% Gratis)",
      "template": "node tools/vane/vane_cli.cjs \"$1\""
    }
  },
  "agent": {
    "chat": {
      "mode": "primary",
      "color": "success",
      "model": "openrouter/inclusionai/ling-3.0-flash-fin:free",
      "description": "💬 Chat 100% GRATIS: Conversación directa sin bucles y con CERO consumo de saldo Go",
      "prompt": "Eres el Asistente de Chat de OpenCode. Respondes de forma clara, directa y concisa en un solo mensaje. No ejecutas bucles automáticos de herramientas."
    },
    "build": {
      "mode": "primary",
      "color": "success",
      "model": "openrouter/inclusionai/ling-3.0-flash-fin:free",
      "steps": 2,
      "description": "🛠️ Build Ultra-Económico (100% GRATIS): Máximo 2 pasos por turno, CERO consumo de saldo Go",
      "prompt": "Eres el Agente Constructor Ultra-Económico. Sé quirúrgico y directo: realiza únicamente los cambios solicitados en un máximo de 2 pasos sin lecturas redundantes ni exploraciones masivas. Detén la ejecución al completar el segundo paso."
    },
    "general": {
      "mode": "primary",
      "color": "success",
      "model": "openrouter/inclusionai/ling-3.0-flash-fin:free",
      "description": "💬 General 100% GRATIS: Modo chat normal con CERO consumo de saldo Go",
      "prompt": "Eres el Asistente General de OpenCode. Respondes de forma directa y concisa en un solo mensaje."
    },
    "plan": {
      "mode": "primary",
      "color": "success",
      "model": "openrouter/inclusionai/ling-3.0-flash-fin:free",
      "description": "📋 Planner 100% GRATIS: Planificación y diseño de soluciones con CERO consumo de saldo Go",
      "prompt": "Eres el Agente Planificador de OpenCode. Creas planes detallados de implementación sin consumir cuota Go."
    },
    "explore": {
      "mode": "subagent",
      "color": "info",
      "model": "openrouter/inclusionai/ling-3.0-flash-fin:free",
      "description": "🔍 Explorer 100% GRATIS: Búsqueda, lectura y análisis de código con CERO consumo de cuota Go",
      "prompt": "Eres el Agente Explorador de OpenCode. Buscas, lees e inspeccionas archivos usando exclusivamente modelos gratuitos."
    },
    "chat_deepseek": {
      "mode": "primary",
      "color": "warning",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "⚡ Chat DeepSeek Flash (0,1¢): 1 solo mensaje directo con DeepSeek, sin bucles de herramientas",
      "prompt": "Eres el Asistente de Chat DeepSeek de OpenCode. Respondes en un único mensaje preciso y conciso. No ejecutas bucles automáticos de herramientas."
    },
    "build_deepseek": {
      "mode": "primary",
      "color": "warning",
      "model": "opencode-go/deepseek-v4.1-flash",
      "steps": 2,
      "description": "⚡ Build DeepSeek Ultra-Económico: Freno estricto a 2 pasos por turno (máximo ~0,4¢ por mensaje)",
      "prompt": "Eres el Constructor DeepSeek Ultra-Económico. Sé quirúrgico y conciso: realiza únicamente la acción necesaria en un máximo de 2 pasos sin lecturas redundantes. Deténte inmediatamente al completar los cambios."
    },
    // ── AGENTES GRATUITOS (OpenRouter) ── No consumen cuota semanal ──────
    "nex_pro": {
      "mode": "primary",
      "color": "primary",
      "model": "openrouter/nex-agi/nex-n2.5-pro:free",
      "description": "🤖 Nex-N2.5 Pro Free: Agente autónomo — explora código, ejecuta comandos, prueba UI y auto-corrige en bucle",
      "prompt": "Eres Nex-N2.5 Pro, un agente de ingeniería de software autónomo. Exploras bases de código, implementas cambios en múltiples archivos, ejecutas comandos, y cuando el resultado no coincide con lo previsto, diagnosticas, corriges y vuelves a probar. Respetas estrictamente APEX_RULES.md.",
      "steps": 20
    },
    "nex_mini": {
      "mode": "primary",
      "color": "info",
      "model": "openrouter/nex-agi/nex-n2.5-mini:free",
      "description": "🤖 Nex-N2.5 Mini Free: Agente autónomo ligero — QA rápido y corrección de bugs en bucle",
      "prompt": "Eres Nex-N2.5 Mini, la versión ágil del agente de ingeniería autónoma de Nex AGI. Exploras código, implementas cambios, ejecutas comandos y verificas en bucle de retroalimentación. Respetas estrictamente APEX_RULES.md.",
      "steps": 12
    },
    "muse_spark": {
      "mode": "primary",
      "color": "primary",
      "model": "openrouter/meta/muse-spark-1.3-contributor:free",
      "description": "🔥 Meta Muse Spark 1.3 Free (OpenRouter): 1M contexto — narración, auditoría y razonamiento agéntico",
      "prompt": "Eres el Agente de Razonamiento Supremo basado en Meta Muse Spark 1.3 Free. Tu especialidad es la auditoría profunda de repositorios masivos, diseño de combate canónico en APEX Power Scaling, arquitectura full-stack y depuración sin cortes de memoria."
    },
    "nemotron_ultra": {
      "mode": "primary",
      "color": "secondary",
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "description": "🧠 Nemotron Ultra 550B Free (OpenRouter): 1M contexto — razonamiento formal y arquitectura",
      "prompt": "Eres el Agente de Razonamiento Supremo basado en NVIDIA Nemotron Ultra 550B MoE Free. Especialista en deducción lógica compleja, balance numérico y arquitectura de software.",
      "temperature": 0.2,
      "steps": 16
    },
    "nemotron_super": {
      "mode": "primary",
      "color": "primary",
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
      "description": "⚡ Nemotron Super 120B Free (OpenRouter): 262k contexto — código full-stack y uso diario [PREDETERMINADO]",
      "prompt": "Eres el Ingeniero Full-Stack de élite basado en NVIDIA Nemotron Super 120B Free. Destacas en refactorización de código, algoritmos de combate, integración de React/Vite y optimización de rendimiento."
    },
    "nemotron_lightning": {
      "mode": "primary",
      "color": "warning",
      "model": "openrouter/nvidia/nemotron-3.5-lightning:free",
      "description": "⚡ Nemotron Lightning Free (OpenRouter): 1M contexto — latencia ultrabaja para respuestas instantáneas",
      "prompt": "Eres el Agente de Latencia Mínima basado en NVIDIA Nemotron 3.5 Lightning Free. Entregas respuestas directas, concisas y sin cuelgues.",
      "temperature": 0.3,
      "steps": 12
    },
    "reasoner_omni": {
      "mode": "primary",
      "color": "accent",
      "model": "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
      "description": "🔍 Nemotron Omni Reasoning Free (OpenRouter): CoT paso a paso — auditoría crítica y verificación formal",
      "prompt": "Eres el Auditor de Razonamiento Reflexivo basado en NVIDIA Nemotron Omni 30B Reasoning Free. Desglosas cada problema paso a paso, detectas incongruencias en Tiers y verificas la corrección formal antes de dar una conclusión."
    },
    "minimax_m3": {
      "mode": "primary",
      "color": "warning",
      "model": "openrouter/minimax/minimax-m3:free",
      "description": "🎭 MiniMax M3 Free (OpenRouter): 1M contexto — narrativa, lore en español y combates What-If",
      "prompt": "Eres el Maestro de Narrativa y Lore basado en MiniMax M3 Free. Redactas crónicas inmersivas, diálogos cinematográficos y arcos narrativos en español."
    },
    "minimax_fast": {
      "mode": "primary",
      "color": "warning",
      "model": "openrouter/minimax/minimax-m2.7:free",
      "description": "🎭 MiniMax M2.7 Free (OpenRouter): Brainstorming ágil y exploración rápida de conceptos",
      "prompt": "Eres el Agente de Brainstorming Ágil basado en MiniMax M2.7 Free. Ideal para sesiones rápidas de preguntas, definición de conceptos e iteraciones veloces."
    },
    "glm_coder": {
      "mode": "primary",
      "color": "secondary",
      "model": "openrouter/z-ai/glm-5.2:free",
      "description": "🔬 GLM 5.2 Free (OpenRouter): 256k contexto — algorítmico, refactorización y lógica matemática",
      "prompt": "Eres el Agente Algorítmico basado en Z-AI GLM 5.2 Free. Tu enfoque es la lógica pura, resolución de bugs complejos y optimización de algoritmos de combate."
    },
    "inkling": {
      "mode": "primary",
      "color": "info",
      "model": "openrouter/thinkingmachines/inkling:free",
      "description": "💡 Inkling Free (OpenRouter): 1M contexto — razonamiento general y código",
      "prompt": "Eres el Agente de Razonamiento General basado en Thinking Machines Inkling Free. Resuelves problemas complejos con pensamiento estructurado y código limpio."
    },
    "gemini_flash_lite": {
      "mode": "primary",
      "color": "info",
      "model": "google/gemini-flash-lite-latest",
      "description": "🌐 Gemini Flash Lite (Google API): 1M contexto — búsqueda web y respuestas instantáneas",
      "prompt": "Eres el Agente de Alta Velocidad basado en Google Gemini Flash Lite Latest. Procesas consultas rápidas, rastreo en la web, verificación de datos en tiempo real y respuestas concisas."
    },
    "build": {
      "mode": "primary",
      "color": "primary",
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
      "description": "🔨 Builder Free (OpenRouter · Nemotron Super 120B): edición, terminal y build sin consumir cuota Go",
      "prompt": "Eres el Agente Constructor principal. Tienes control de terminal, edición de ficheros y despliegues. Usas Nemotron Super 120B Free de OpenRouter para no consumir cuota de OpenCode Go."
    },
    "deepseek_fast": {
      "mode": "primary",
      "color": "info",
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
      "description": "⚡ Agente Rápido Free (OpenRouter · Nemotron Super): sustituto de DeepSeek Flash hasta que se renueve cuota",
      "prompt": "Eres el Agente Principal de respuesta rápida basado en Nemotron Super 120B Free. Resuelves tareas de código, análisis y arquitectura sin consumir cuota de OpenCode Go."
    },
    // ── AGENTES OPENCODE GO AUTORIZADOS (FLASH ONLY) ──────────────────────────
    // ⚠️ Solo modelos Flash de bajo consumo. Modelos caros Pro/Max siguen estrictamente prohibidos.
    "deepseek_v41_flash": {
      "mode": "primary",
      "color": "accent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "🚀 [PROMO 4X CUOTA] DeepSeek V4.1 Flash (OpenCode Go) — 130k peticiones/mes, visión+código y 384k salida [USAR ESTE AHORA]",
      "prompt": "Eres el Agente Principal de OpenCode Go basado en DeepSeek V4.1 Flash con arquitectura CED (552B MoE), 1.000.000 tokens de contexto y 384.000 tokens de salida. Cuentas con la promoción de 4x de cuota en OpenCode Go. Resuelves código, análisis visual de imágenes y arquitectura con máxima precisión y la mayor eficiencia posible."
    },
    "deepseek_v4_flash": {
      "mode": "primary",
      "color": "info",
      "model": "opencode-go/deepseek-v4-flash",
      "description": "⚡ DeepSeek V4 Flash Clásico (OpenCode Go) — 65k peticiones/mes. Reserva para cuando finalice la promo de V4.1",
      "prompt": "Eres el Agente de OpenCode Go basado en DeepSeek V4 Flash clásico con 1.000.000 tokens de contexto. Resuelves tareas de código, análisis y arquitectura con máxima estabilidad y mínimo consumo de cuota."
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 16384,
    "reserved": 8192
  },
  "tool_output": {
    "max_lines": 350,
    "max_bytes": 24576
  },
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 300000
      },
      "models": {
  "inclusionai/ling-3.0-flash-vl:free": {
    "name": "inclusionAI: Ling 3.0 Flash VL (free)",
    "limit": {
      "context": 262144,
      "output": 32768
    },
    "temperature": true
  },
  "nex-agi/nex-n2.5-mini:free": {
    "name": "Nex AGI: Nex-N2.5-Mini (free)",
    "limit": {
      "context": 262144,
      "output": 235929
    },
    "temperature": true
  },
  "nex-agi/nex-n2.5-pro:free": {
    "name": "Nex AGI: Nex-N2.5-Pro (free)",
    "limit": {
      "context": 262144,
      "output": 235929
    },
    "temperature": true
  },
  "inclusionai/ling-3.0-flash-sante:free": {
    "name": "inclusionAI: Ling 3.0 Flash Sante (free)",
    "limit": {
