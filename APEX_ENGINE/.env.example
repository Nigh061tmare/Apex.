# Copia este archivo a .env y rellena lo que necesites. Todo es opcional.

# Puerto del backend local (server.cjs). Por defecto 3001.
PORT=3001

# Clave de OpenCode para los endpoints de IA del backend (/api/simulate, /api/scenario/generate...).
# Sin ella la web sigue funcionando con los proveedores que configures en el modal de IA.
OPENCODE_API_KEY=
